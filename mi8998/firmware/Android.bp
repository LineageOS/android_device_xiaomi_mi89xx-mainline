    device_specific: true,
    installed_location: "firmware/qcom/msm8998/xiaomi/slpi.mbn",
    symlink_target: "/vendor/firmware_mnt/image/slpi.mdt",
}

/*
```bash
for f in adsp.b{00..11} mba.mbn modem.b{00..28} slpi.b{00..13} wlanmdsp.mbn; do
echo "install_symlink {
    name: \"symlink_firmware_mi8998_${f}\",
    device_specific: true,
    installed_location: \"firmware/qcom/msm8998/xiaomi/${f}\",
    symlink_target: \"/vendor/firmware_mnt/image/${f}\",
}
"
done
```

```bash
for f in adsp.b{00..11} mba.mbn modem.b{00..28} slpi.b{00..13} wlanmdsp.mbn; do
echo "        \"symlink_firmware_mi8998_${f}\","
done
```
*/

