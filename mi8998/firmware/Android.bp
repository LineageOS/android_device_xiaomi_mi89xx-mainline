install_symlink {
    name: "symlink_firmware_mi8998",
    vendor: true,
    installed_location: "firmware/qcom/msm8998/xiaomi",
    symlink_target: "/odm/firmware/qcom/msm8998/xiaomi",
}

install_symlink {
    name: "symlink_firmware_mi8998_a540_gpmu.fw2",
    vendor: true,
    installed_location: "firmware/qcom/a540_gpmu.fw2",
    symlink_target: "/odm/firmware/qcom/a540_gpmu.fw2",
}

install_symlink {
    name: "symlink_firmware_mi8998_adsp.mbn",
    device_specific: true,
    installed_location: "firmware/qcom/msm8998/xiaomi/adsp.mbn",
    symlink_target: "/vendor/firmware_mnt/image/adsp.mdt",
}

install_symlink {
    name: "symlink_firmware_mi8998_modem.mbn",
    device_specific: true,
    installed_location: "firmware/qcom/msm8998/xiaomi/modem.mbn",
