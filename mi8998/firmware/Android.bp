genrule {
    name: "gen_firmware_mi8998_ipa_fws.mbn",
    tools: ["pil-squasher"],
    out: ["ipa_fws.mbn"],
    cmd: "$(location pil-squasher) $(out) ../../../../../vendor/xiaomi/msm8998-common/proprietary/vendor/firmware/ipa_fws.mdt",
}

prebuilt_firmware {
    name: "firmware_mi8998_ipa_fws.mbn",
    src: ":gen_firmware_mi8998_ipa_fws.mbn",
    filename_from_src: true,
    device_specific: true,
    sub_dir: "qcom/msm8998/xiaomi",
}

// Workaround soong installing device_specific prebuilt_firmware module to /odm/etc/firmware
install_symlink {
    name: "symlink_firmware_mi8998_ipa_fws.mbn",
    device_specific: true,
    installed_location: "firmware/qcom/msm8998/xiaomi/ipa_fws.mbn",
    symlink_target: "/odm/etc/firmware/qcom/msm8998/xiaomi/ipa_fws.mbn",
}

