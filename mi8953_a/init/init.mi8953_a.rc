import /vendor/etc/init/hw/init.mi89xx.rc

# Kernel module loading
on post-fs
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -s -d /vendor/lib/modules --all=/vendor/etc/modules.load.normal
    trigger start_all_remoteproc

# Sensors
on early-boot && property:ro.vendor.device.codename=vince
    setprop vendor.sensors.composite.device_orientation.enabled true
    setprop vendor.sensors.orientation.invert_x true
    setprop vendor.sensors.orientation.invert_y true
