import /init.recovery.mi89xx.rc

# Device-mapper
on early-fs
    exec - root root -- /system/bin/dmctl create boot linear 0 98304 /dev/block/by-name/cache 0
    exec - root root -- /system/bin/dmctl create recovery linear 0 147456 /dev/block/by-name/cache 98304
    exec - root root -- /system/bin/dmctl create metadata linear 0 65536 /dev/block/by-name/cache 245760
    exec - root root -- /system/bin/dmctl create cache linear 0 344064 /dev/block/by-name/cache 311296

# Input (ts_vkeys)
on property:ro.vendor.device.codename=wt88047
    setprop vendor.ts_vkeys.menu.x 160
    setprop vendor.ts_vkeys.menu.y 1344
    setprop vendor.ts_vkeys.menu.key_code 139
    setprop vendor.ts_vkeys.home.x 360
    setprop vendor.ts_vkeys.home.y 1344
    setprop vendor.ts_vkeys.home.key_code 172
    setprop vendor.ts_vkeys.back.x 570
    setprop vendor.ts_vkeys.back.y 1344
    setprop vendor.ts_vkeys.back.key_code 158
    setprop vendor.ts_vkeys.names menu,home,back
