<audiohal>
    <mixer card="0">
        <init>
            <!-- File: ucm2/conf.d/xiaomi-ugg/xiaomi-ugg.conf -->
            <!-- Headphones and Earpiece Volume -->
            <ctl name="RX1 Digital Volume" val="84"/>
            <ctl name="RX2 Digital Volume" val="84"/>
            <!-- Speaker Volume -->
            <ctl name="RX3 Digital Volume" val="84"/>
            <!-- Primary Mic Analog -->
            <ctl name="ADC1 Volume" val="6"/>
            <!-- Headphones Mic Analog -->
            <ctl name="ADC2 Volume" val="6"/>
            <!-- Secondary Mic Analog -->
            <ctl name="ADC3 Volume" val="6"/>
            <!-- File: ucm2/Xiaomi/ugg/HiFi.conf -->
            <ctl name="PRI_MI2S_RX Audio Mixer MultiMedia1" val="1"/>
            <ctl name="MultiMedia2 Mixer TERT_MI2S_TX" val="1"/>
            <ctl name="PRI_MI2S_RX Voice Mixer VoiceMMode1" val="1"/>
            <ctl name="VoiceMMode1 Capture Mixer TERT_MI2S_TX" val="1"/>
        </init>
    </mixer>
    <device name="speaker">
        <path name="on">
            <!-- File: ucm2/Xiaomi/ugg/HiFi.conf -->
            <ctl name="Speaker Switch" val="1"/>
        </path>
        <path name="off">
            <!-- File: ucm2/Xiaomi/ugg/HiFi.conf -->
            <ctl name="Speaker Switch" val="0"/>
        </path>
        <path name="pcm_on">
            <!-- File: ucm2/codecs/msm8953-wcd/SpeakerHPHLDisableSeq.conf -->
            <ctl name="RX1 MIX1 INP1" val="RX1"/>
            <ctl name="RDAC2 MUX" val="RX2"/>
            <ctl name="HPHL" val="1"/>
        </path>
        <path name="pcm_off">
            <!-- File: ucm2/codecs/msm8953-wcd/SpeakerHPHLDisableSeq.conf -->
            <ctl name="HPHL" val="0"/>
            <ctl name="RX1 MIX1 INP1" val="ZERO"/>
        </path>
    </device>
    <stream type="pcm" dir="out" card="0" device="0">
        <enable path="pcm_on"/>
        <disable path="pcm_off"/>
    </stream>
</audiohal>
